{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && node ../../scripts/src/free-dev-port.mjs && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm run lint",
    "lint": "eslint --config eslint.config.mjs --max-warnings 0 .",
    "test": "vitest run",
    "test:unit": "vitest run --exclude '**/platform-errors.retention.test.ts' --exclude '**/*.db.test.ts'",
    "test:db": "vitest run -c vitest.db.config.ts"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.21.0",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/entitlements": "workspace:*",
    "@workspace/shift-defaults": "workspace:*",
    "@workspace/test-fixtures": "workspace:*",
    "compression": "^1.8.1",
    "connect-pg-simple": "^10.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "google-auth-library": "^10.7.0",
    "jszip": "^3.10.1",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/node": "catalog:",
    "@types/pg": "^8.20.0",
    "esbuild": "^0.28.1",
    "esbuild-plugin-pino": "^2.3.3",
    "eslint": "^10.7.0",
    "pg": "^8.20.0",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0",
    "typescript-eslint": "^8.64.0",
    "vitest": "^4.1.8"
  }
}
