modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "typecheck"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "unit"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "e2e"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "handbuch-screenshots"

[[workflows.workflow]]
name = "typecheck"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm run typecheck"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "unit"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/dienstplan run test && pnpm --filter @workspace/db run test && pnpm --filter @workspace/api-server run test:unit && pnpm --filter @workspace/scripts run test"

[[workflows.workflow]]
name = "e2e"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/scripts run scoped-e2e"

[[workflows.workflow]]
name = "handbuch-screenshots"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/dienstplan run screenshots:handbuch:check"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000

[[ports]]
localPort = 8080
externalPort = 80

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 8082
externalPort = 3002

[[ports]]
localPort = 18115
externalPort = 3001

[[ports]]
localPort = 18116
externalPort = 3003

[[ports]]
localPort = 20361
externalPort = 3000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
ERROR_ALERT_EMAIL = "kontakt@assistenztreff.de"
ERROR_ALERT_FROM = "Dienstplan-App <alerts@mail.assistenztreff.de>"
DATABASE_SSL_NO_VERIFY = "1"

[userenv.development]

[userenv.production]

[objectStorage]
defaultBucketID = "replit-objstore-41a84f93-38b8-403d-b0e1-9371dea9138a"
